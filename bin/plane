#!/usr/bin/env sh
# plane — Plane ticket CLI shim (HomeTutor fleet).
#
# HOT PATH: zero git, zero network. Resolves the pinned release symlink and
# execs bun. Updates happen in the BACKGROUND (bin/update-live.sh via the
# systemd timer, tag-based) — a run in flight keeps its version; the next
# invocation picks up the newly pinned release.
#
# Layout (operator directive):
#   /home/rafael/Development/plane-cli-releases/<tag>   released copies
#   /home/rafael/Development/plane-cli-current          symlink → release
#   Dev happens in /home/rafael/Development/plane-cli (worktrees) — NEVER
#   executed by agents.
set -e
CURRENT="${PLANE_CLI_CURRENT:-/home/rafael/Development/plane-cli-current}"
if [ ! -e "$CURRENT/src/cli.ts" ]; then
  echo "plane: no release pinned at $CURRENT — run plane-cli bin/deploy.sh or bin/update-live.sh" >&2
  exit 1
fi
BUN="$(command -v bun || echo "$HOME/.bun/bin/bun")"
exec "$BUN" run "$CURRENT/src/cli.ts" "$@"
