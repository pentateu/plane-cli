{
  "v": 1,
  "loops": {
    "page-edit": {
      "steps": [
        "pull the page (ot pull <page> --out <dir>)",
        "edit the local md file",
        "validate (R-12: mermaid renders, json parses, fence parity, byte-claims)",
        "push with revision guard (ot push <page> <file> --publish --expect-rev <updatedAt>)",
        "round-trip verify (re-pull + diff byte-identical)"
      ],
      "rules": [
        "R-11 local-first loop is the standard for ALL page edits",
        "R-12 pre-push validation is mandatory"
      ],
      "governing": [
        "§29.2 (hub ab0cf76a-ac52-4c85-9b37-9f389ce391c8)",
        "R-11/R-12 (§19.3, P9)"
      ]
    },
    "comment-read": {
      "steps": [
        "read human feedback in one call (ot comment list <page> --unanswered)",
        "act in a LOCAL review file, never the page thread",
        "reply via verdict or wake, never an agent page comment"
      ],
      "rules": [
        "R-14 one call: comment list <page> --unanswered",
        "R-13 agents never comment pages"
      ],
      "governing": [
        "§29.3 (hub)",
        "R-13/R-14 (§19.3, P9)"
      ]
    },
    "ticket-work": {
      "steps": [
        "check blockers (plane list --blocked-by <id>)",
        "claim the ticket (plane claim <id> --comment \"starting\")",
        "work the ticket; record progress on Plane",
        "hand over for review (handover)",
        "verdict loop until APPROVE"
      ],
      "rules": [
        "R-13 agents never comment Outline pages",
        "R-7 --dry-run covers every mutating verb",
        "R-1/R-4 no silent truncation; compact JSON on machine reads"
      ],
      "governing": [
        "§2 tool action map + §13 manager action tools (P1 d9a264d3-fce1-48f0-9ea6-668463832ff6)",
        "R-13 (§19.3, P9)"
      ]
    },
    "ticket-machine": {
      "steps": [
        "start_ticket (claim + spawn + journal pair)",
        "work the ticket; the journal is truth",
        "handover (sha == tip, clean worktree)",
        "verdict (APPROVE / WITH_CHANGES / BLOCK)",
        "approve (test cases + merge gate)",
        "merge-approved"
      ],
      "rules": [
        "R-5 handover/wake paths first",
        "R-7 --dry-run covers every mutating verb"
      ],
      "governing": [
        "§1.2–§1.6 (hub) + §10/§12 wake payloads (P2 dbc8b736-afd1-47f3-81c3-2b62e9b4af93) + §28 roster/tell (P6 d237f715-d9ab-44a3-ab77-34819a33cd5f)"
      ]
    }
  },
